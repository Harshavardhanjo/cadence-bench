# build output
/cadence
/cadence.exe
/bin/

# measurement output (regenerate with `make run`)
/results/*.json
/results/*.csv

# python
__pycache__/
*.pyc
.venv/

# UI
ui/node_modules/
ui/.next/
ui/out/
ui/tsconfig.tsbuildinfo
ui/next-env.d.ts

# Generated by ui/scripts/build-wasm.mjs on every dev and build. Committing them
# would let a stale binary ship alongside changed Go source, which for a tool
# whose whole claim is that the UI runs the same code is the one thing to avoid.
ui/public/cadence.wasm
ui/public/wasm_exec.js
